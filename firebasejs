/* =====================================================
   SAVE SOS ALERT
===================================================== */

export async function saveSOSAlert(locationData) {

    try {

        /* ---------------------------------------------
           CHECK LOCATION
        --------------------------------------------- */

        if (!locationData) {

            throw new Error(
                "GPS location not available."
            );

        }


        if (
            typeof locationData.latitude !== "number" ||
            typeof locationData.longitude !== "number"
        ) {

            throw new Error(
                "Invalid GPS coordinates."
            );

        }


        /* ---------------------------------------------
           CREATE ALERT DATA
        --------------------------------------------- */

        const alertData = {

            type:
                "SOS",

            status:
                "ACTIVE",

            message:
                "Emergency SOS activated",

            location: {

                latitude:
                    locationData.latitude,

                longitude:
                    locationData.longitude,

                accuracy:
                    locationData.accuracy || 0

            },

            createdAt:
                serverTimestamp(),

            source:
                "Cloud-Emergency-SOS-System"

        };


        /* ---------------------------------------------
           SAVE TO FIRESTORE
        --------------------------------------------- */

        const docRef =
            await addDoc(

                collection(
                    db,
                    "emergencyAlerts"
                ),

                alertData

            );


        /* ---------------------------------------------
           SUCCESS
        --------------------------------------------- */

        console.log(
            "================================"
        );

        console.log(
            "SOS ALERT SAVED"
        );

        console.log(
            "Alert ID:",
            docRef.id
        );

        console.log(
            "Latitude:",
            locationData.latitude
        );

        console.log(
            "Longitude:",
            locationData.longitude
        );

        console.log(
            "================================"
        );


        return docRef.id;


    } catch (error) {

        /* ---------------------------------------------
           ERROR
        --------------------------------------------- */

        console.error(
            "Firebase SOS Error:",
            error
        );

        throw error;

    }

}
